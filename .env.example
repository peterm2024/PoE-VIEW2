# Lokale Konfiguration — nach ".env" kopieren und ausfüllen.
# Die .env steht in .gitignore und wird NIEMALS committet.

# OAuth-Client-ID der bei GGG registrierten App (public client, PKCE)
POE_CLIENT_ID=poeview

# Kontakt-E-Mail für den User-Agent-Header (Pflicht laut GGG-API-Regeln).
# Diese Adresse bleibt lokal — sie taucht nirgends im Repository auf.
POE_CONTACT_EMAIL=deine@email.example
